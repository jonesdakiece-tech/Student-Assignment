#include <iostream>
using namespace std;

int main() {
    char firstCharacter;
    char secondCharacter;

    cout << "Enter two characters separated by a space: ";
    cin >> firstCharacter;
    cin >> secondCharacter;

    cout << "First: [" << firstCharacter << "]" << endl;
    cout << "Second: [" << secondCharacter << "]" << endl;

    return 0;
}

